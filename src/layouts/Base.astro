---
import Icon from '../components/Icon.astro';
import { SITE_NAME } from '../data/site.js';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, crumbs = [], jsonLd = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;
const current = Astro.url.pathname;
// Add the brand only when it still fits in ~65 characters (Google truncates longer titles).
const branded = `${title} | ${SITE_NAME}`;
const fullTitle = current === '/' || branded.length > 65 ? title : branded;

const nav = [
  { href: '/plantas/', label: 'Plantas', icon: 'leaf' },
  { href: '/plagas/', label: 'Plagas', icon: 'bug' },
  { href: '/sustratos-y-macetas/', label: 'Sustratos', icon: 'layers' },
  { href: '/abonos/', label: 'Abonos', icon: 'sprout' },
];

const schemas = [...jsonLd];
if (crumbs.length > 1) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  });
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f6b3a" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${SITE_NAME}, inicio`}>
          <span class="brand-mark"><Icon name="leaf" size={20} /></span>
          <span>Hoja<span class="brand-accent">pedia</span></span>
        </a>
        <nav aria-label="Principal">
          {nav.map((item) => (
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              <Icon name={item.icon as never} size={18} />
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="contenido" class="wrap">
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="Ruta de navegación">
          <ol>
            {crumbs.map((crumb, index) => (
              <li>
                {index < crumbs.length - 1
                  ? <a href={crumb.path}>{crumb.name}</a>
                  : <span aria-current="page">{crumb.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-brand"><Icon name="leaf" size={18} /> {SITE_NAME}</p>
        <p>
          Fichas de cuidado de plantas basadas en fuentes botánicas y universitarias, citadas en cada página.
          La toxicidad para mascotas se comprueba en la base de datos de la ASPCA.
        </p>
        <p class="credits">Iconos: <a href="https://lucide.dev" rel="noopener">Lucide</a>.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f6f8f1;
    --surface: #ffffff;
    --ink: #1c2a1f;
    --muted: #55645a;
    --line: #dfe7d6;
    --leaf: #1f6b3a;
    --leaf-dark: #154d29;
    --leaf-soft: #e3f1e4;
    --sun: #b06d00;
    --sun-soft: #fff1d1;
    --water: #1d5f8a;
    --water-soft: #e1eff8;
    --ok: #12703f;
    --ok-soft: #dcf4e5;
    --bad: #b3261e;
    --bad-soft: #fde4e1;
    --radius: 18px;
    --shadow: 0 8px 24px rgb(30 60 35 / 8%);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 1.0625rem/1.65 system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  }
  .wrap { width: min(100%, 58rem); margin-inline: auto; padding-inline: 1rem; }
  a { color: var(--leaf); text-underline-offset: 0.15em; }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.01em; }
  h1 { font-size: clamp(1.9rem, 6vw, 2.7rem); font-weight: 800; margin: 0.5rem 0; }
  h2 { font-size: 1.45rem; font-weight: 750; margin: 2.25rem 0 0.7rem; color: var(--leaf-dark); }
  h3 { font-size: 1.1rem; font-weight: 700; margin: 1.25rem 0 0.3rem; }
  .icon { flex: none; vertical-align: -0.2em; }
  .lead { font-size: 1.15rem; margin: 0.25rem 0 0; }
  .muted { color: var(--muted); }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 0.5rem; background: var(--surface); padding: 0.5rem 0.75rem; z-index: 10; }
  :focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }

  .site-header { position: sticky; top: 0; z-index: 5; background: rgb(255 255 255 / 94%); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 850; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  .brand-accent { color: var(--leaf); }
  .brand-mark { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 10px; color: #fff; background: var(--leaf); }
  .bar nav { display: flex; gap: 0.25rem; }
  .bar nav a { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 2.5rem; padding: 0.3rem 0.75rem; border-radius: 999px; color: var(--ink); font-weight: 650; text-decoration: none; }
  .bar nav a:hover { background: var(--leaf-soft); }
  .bar nav a[aria-current='page'] { background: var(--leaf); color: #fff; }
  @media (max-width: 40rem) {
    .bar { flex-direction: column; align-items: stretch; gap: 0.4rem; padding-block: 0.5rem; }
    .bar .brand { align-self: center; }
    .bar nav { display: grid; grid-template-columns: repeat(4, 1fr); }
    .bar nav a { flex-direction: column; gap: 0.1rem; padding: 0.25rem 0.1rem; border-radius: 12px; font-size: 0.75rem; min-height: 3rem; justify-content: center; }
  }

  main { padding-block: 0.75rem 3rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.2rem 0.5rem; list-style: none; margin: 0.5rem 0 0.5rem; padding: 0; font-size: 0.875rem; color: var(--muted); }
  .crumbs li + li::before { content: '›'; margin-right: 0.5rem; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem; margin-block: 1.1rem; box-shadow: var(--shadow); }
  .pill { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.15rem 0.65rem; border-radius: 999px; font-size: 0.85rem; font-weight: 700; white-space: nowrap; background: var(--leaf-soft); color: var(--leaf-dark); }
  .pill.ok { background: var(--ok-soft); color: var(--ok); }
  .pill.bad { background: var(--bad-soft); color: var(--bad); }

  .table-scroll { overflow-x: auto; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; font-size: 0.975rem; }
  th, td { text-align: left; padding: 0.65rem 0.8rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  tr:last-child td, tr:last-child th { border-bottom: 0; }
  thead th { background: var(--leaf-soft); color: var(--leaf-dark); }

  .plant-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); list-style: none; padding: 0; margin: 1rem 0 0; }
  .plant-link { display: flex; flex-direction: column; gap: 0.2rem; height: 100%; padding: 0.9rem 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; color: var(--ink); text-decoration: none; box-shadow: var(--shadow); }
  .plant-link:hover { border-color: var(--leaf); }
  .plant-link strong { font-size: 1.1rem; }
  .plant-link em { color: var(--muted); font-size: 0.9rem; }
  .plant-link .pill { align-self: flex-start; margin-top: 0.35rem; }

  .sources { font-size: 0.925rem; color: var(--muted); }
  .sources ul { padding-left: 1.2rem; margin: 0.4rem 0; }
  .site-footer { margin-top: 1rem; background: var(--leaf-dark); color: #e4efe5; font-size: 0.925rem; padding-block: 1.5rem; }
  .site-footer p { margin: 0.3rem 0; }
  .footer-brand { display: flex; align-items: center; gap: 0.4rem; font-weight: 850; font-size: 1.1rem; color: #fff; }
  .credits { font-size: 0.8rem; color: #bcd2bf; }
  .credits a { color: inherit; }
</style>
