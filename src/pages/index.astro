---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE_NAME } from '../data/site.js';
import { petVerdict } from '../lib/format.js';

const plants = (await getCollection('plants')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'es'));
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: Astro.site?.href, inLanguage: 'es' }];
---
<Base
  title="Hojapedia: cuidados de plantas de interior y jardín"
  description="Guías claras para cuidar tus plantas: luz, riego, sustrato, plagas y si son tóxicas para gatos y perros. Con calendario para el hemisferio norte y sur."
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>Cuida tus plantas sin adivinar</h1>
    <p class="lead">Fichas de cuidado con datos comprobados: cuánta luz necesitan, cuándo regarlas, qué sustrato usar, qué hacer si amarillean y si son seguras para gatos y perros.</p>
    <ul class="promises">
      <li><Icon name="book-open" size={18} /> Fuentes botánicas citadas en cada ficha</li>
      <li><Icon name="cat" size={18} /> Toxicidad para mascotas según la ASPCA</li>
      <li><Icon name="calendar" size={18} /> Épocas para el hemisferio norte y sur</li>
    </ul>
  </section>

  <h2>Fichas de plantas</h2>
  <ul class="plant-grid">
    {plants.map((plant) => {
      const pets = petVerdict(plant.data.toxicity);
      return (
        <li>
          <a class="plant-link" href={`/plantas/${plant.id}/`}>
            <strong>{plant.data.name}</strong>
            <em>{plant.data.scientific}</em>
            <span class:list={['pill', pets.tone]}>{pets.text}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <p><a href="/plantas/">Ver todas las fichas <Icon name="chevron-right" size={18} /></a></p>

  <h2>Guías</h2>
  <ul class="plant-grid">
    <li><a class="plant-link" href="/herramientas/buscador-de-plantas/"><strong><Icon name="search" size={18} /> ¿Qué planta me conviene?</strong><span class="muted">Buscador por luz, lugar y mascotas</span></a></li>
    <li><a class="plant-link" href="/listas/plantas-toxicas-para-gatos-y-perros/"><strong><Icon name="cat" size={18} /> Plantas tóxicas para gatos y perros</strong><span class="muted">Cuáles son seguras y cuáles no, según la ASPCA</span></a></li>
    <li><a class="plant-link" href="/plagas/"><strong><Icon name="bug" size={18} /> Plagas</strong><span class="muted">Pulgones, cochinilla y cómo controlarlas con poco riesgo</span></a></li>
    <li><a class="plant-link" href="/sustratos-y-macetas/"><strong><Icon name="layers" size={18} /> Sustratos y macetas</strong><span class="muted">Qué tierra usar, perlita y mezclas</span></a></li>
    <li><a class="plant-link" href="/abonos/"><strong><Icon name="sprout" size={18} /> Abonos</strong><span class="muted">Humus de lombriz y cómo abonar</span></a></li>
  </ul>
</Base>

<style>
  .hero { background: var(--leaf-dark); color: #fff; border-radius: 24px; padding: 1.6rem 1.3rem; margin-top: 0.75rem; }
  .hero h1 { margin-top: 0; }
  .promises { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.4rem; }
  .promises li { display: flex; gap: 0.5rem; align-items: center; }
</style>
