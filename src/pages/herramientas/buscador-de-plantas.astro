---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlantTile from '../../components/PlantTile.astro';
import { isPetSafe } from '../../lib/finder.js';

const plants = (await getCollection('plants')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'es'));
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Buscador de plantas', path: Astro.url.pathname }];
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Buscador de plantas por luz, lugar y mascotas',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  inLanguage: 'es',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
}];
---
<Base
  title="Buscador de plantas por luz, lugar y mascotas"
  description="Encuentra la planta adecuada para tu casa o tu terraza: filtra por luz (sol, semisombra o poca luz), interior o exterior, dificultad y seguridad para gatos y perros."
  crumbs={crumbs}
  jsonLd={jsonLd}
>
  <h1>¿Qué planta me conviene?</h1>
  <p class="lead">Elige la luz que tienes, dónde va la planta y si convives con gatos o perros. Te mostramos las plantas de nuestras fichas que encajan.</p>

  <form class="card finder" id="finder" aria-label="Filtros">
    <fieldset>
      <legend><Icon name="sun" size={18} /> ¿Cuánta luz tiene el lugar?</legend>
      <label><input type="radio" name="light" value="" checked /> Cualquiera</label>
      <label><input type="radio" name="light" value="sol" /> Sol directo varias horas</label>
      <label><input type="radio" name="light" value="semisombra" /> Mucha luz sin sol directo</label>
      <label><input type="radio" name="light" value="sombra" /> Poca luz</label>
    </fieldset>
    <fieldset>
      <legend><Icon name="leaf" size={18} /> ¿Dónde va a estar?</legend>
      <label><input type="radio" name="place" value="" checked /> Da igual</label>
      <label><input type="radio" name="place" value="interior" /> Dentro de casa</label>
      <label><input type="radio" name="place" value="exterior" /> Terraza, balcón o jardín</label>
    </fieldset>
    <fieldset>
      <legend><Icon name="cat" size={18} /> Mascotas y dificultad</legend>
      <label><input type="checkbox" name="petSafe" value="1" /> Solo seguras para gatos y perros</label>
      <label><input type="checkbox" name="easy" value="1" /> Solo fáciles de cuidar</label>
    </fieldset>
  </form>

  <p class="count" id="count" aria-live="polite">{plants.length} plantas</p>
  <ul class="tile-grid" id="results">
    {plants.map((p) => (
      <li
        data-light={p.data.traits.light.join(' ')}
        data-place={p.data.traits.place.join(' ')}
        data-safe={isPetSafe(p.data) ? '1' : '0'}
        data-difficulty={p.data.difficulty}
      >
        <PlantTile plant={p} />
      </li>
    ))}
  </ul>
  <p class="empty" id="empty" hidden>Ninguna de nuestras fichas encaja con todos los filtros todavía. Prueba a quitar alguno: añadimos plantas nuevas con regularidad.</p>

  <p class="sources">La luz y el lugar de cada planta resumen su ficha de cuidados, basada en fuentes botánicas y universitarias. La seguridad para mascotas procede de la ASPCA.</p>
</Base>

<script>
  // Progressive enhancement: without JS every plant stays visible.
  const form = document.getElementById('finder') as HTMLFormElement;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#results li'));
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  function apply() {
    const data = new FormData(form);
    const light = String(data.get('light') ?? '');
    const place = String(data.get('place') ?? '');
    const petSafe = data.has('petSafe');
    const easy = data.has('easy');
    let shown = 0;
    for (const li of items) {
      const ok = (!light || li.dataset.light!.split(' ').includes(light))
        && (!place || li.dataset.place!.split(' ').includes(place))
        && (!petSafe || li.dataset.safe === '1')
        && (!easy || li.dataset.difficulty === 'fácil');
      li.hidden = !ok;
      if (ok) shown += 1;
    }
    count.textContent = shown === 1 ? '1 planta' : `${shown} plantas`;
    empty.hidden = shown > 0;
  }
  form.addEventListener('change', apply);
  apply();
</script>

<style>
  .finder { display: grid; gap: 0.75rem; }
  .finder fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.5rem; }
  .finder legend { font-weight: 750; margin-bottom: 0.35rem; width: 100%; }
  .finder label { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.5rem; padding: 0.2rem 0.85rem; border-radius: 999px; background: var(--bg); cursor: pointer; }
  .finder label:has(input:checked) { background: var(--leaf-soft); border-color: var(--leaf); }
  .count { font-weight: 750; margin-bottom: 0; }
  .tile-grid li[hidden], .empty[hidden] { display: none; }
</style>
