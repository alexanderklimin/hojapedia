---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { GUIDE_SECTIONS, plantsForGuide } from '../lib/related.js';
import { formatDate } from '../lib/format.js';
import { SITE_NAME } from '../data/site.js';

interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const g = guide.data;
const section = GUIDE_SECTIONS[g.kind];
const url = new URL(Astro.url.pathname, Astro.site).href;
const plants = plantsForGuide(g, await getCollection('plants')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'es'));
const relatedHeading = g.kind === 'plaga' ? `Plantas que suelen tener ${g.name.toLowerCase()}` : `Plantas que lo usan`;

const jsonLd: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.description,
  inLanguage: 'es',
  dateModified: g.reviewed,
  mainEntityOfPage: url,
  about: { '@type': 'Thing', name: g.name, alternateName: g.synonyms },
  publisher: { '@type': 'Organization', name: SITE_NAME },
  citation: g.sources.map((s) => s.url),
}];
for (const s of g.sections.filter((s) => s.ordered && s.list)) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `${s.heading}: ${g.name.toLowerCase()}`,
    step: s.list!.map((text, index) => ({ '@type': 'HowToStep', position: index + 1, text })),
  });
}
if (g.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  });
}
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: section.label, path: section.path },
  { name: g.name, path: Astro.url.pathname },
];
---
<Base title={g.title} description={g.description} crumbs={crumbs} jsonLd={jsonLd} ogType="article">
  <article>
    <h1>{g.name}</h1>
    {g.synonyms.length > 0 && <p class="muted">Otros nombres: {g.synonyms.join(', ')}</p>}
    <p class="lead">{g.summary}</p>

    <nav class="card toc" aria-label="En esta página">
      <strong>En esta página</strong>
      <ol>{g.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}</ol>
    </nav>

    {g.sections.map((s) => (
      <section>
        <h2 id={s.id}>{s.heading}</h2>
        {s.paragraphs.map((text) => <p>{text}</p>)}
        {s.list && (s.ordered
          ? <ol class="guide-list">{s.list.map((item) => <li>{item}</li>)}</ol>
          : <ul class="guide-list">{s.list.map((item) => <li>{item}</li>)}</ul>)}
      </section>
    ))}

    {g.kind === 'plaga' && (
      <p class="notice">Usa cualquier producto solo según las instrucciones de su etiqueta y mantén plantas tratadas, productos y envases fuera del alcance de niños y mascotas.</p>
    )}

    {plants.length > 0 && (
      <section>
        <h2 id="plantas">{relatedHeading}</h2>
        <ul class="plant-grid">
          {plants.map((plant) => (
            <li><a class="plant-link" href={`/plantas/${plant.id}/`}><strong>{plant.data.name}</strong><em>{plant.data.scientific}</em></a></li>
          ))}
        </ul>
      </section>
    )}

    {g.faq.length > 0 && (
      <>
        <h2 id="preguntas"><Icon name="info" /> Preguntas frecuentes</h2>
        {g.faq.map((item) => (
          <details class="faq"><summary>{item.q}</summary><p>{item.a}</p></details>
        ))}
      </>
    )}

    <section class="sources" aria-labelledby="fuentes">
      <h2 id="fuentes"><Icon name="book-open" /> Fuentes</h2>
      <ul>{g.sources.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}</ul>
      <p>Revisado el {formatDate(g.reviewed)}.</p>
    </section>
  </article>
</Base>

<style>
  .toc ol { margin: 0.4rem 0 0; padding-left: 1.3rem; }
  .guide-list { display: grid; gap: 0.45rem; padding-left: 1.3rem; }
  .notice { background: var(--sun-soft); border-radius: 14px; padding: 0.8rem 1rem; }
  .faq { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 0.75rem 1rem; margin-block: 0.5rem; }
  .faq summary { font-weight: 700; cursor: pointer; }
  .faq p { margin: 0.5rem 0 0; }
</style>
