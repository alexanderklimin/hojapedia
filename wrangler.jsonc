{
  // Статический сайт на Cloudflare Workers (static assets). Сборка: npm run build → dist/
  // Превью на *.workers.dev (Workers Builds из GitHub). При запуске: routes с доменом, workers_dev=false, убрать noindex из public/_headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hojapedia",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
