{
  // Статический сайт на Cloudflare Workers (static assets). Сборка: npm run build → dist/
  // Продакшен на hojapedia.com (запуск 2026-11-19 по «да» пользователя). Сборка из GitHub через Workers Builds.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hojapedia",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "hojapedia.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
